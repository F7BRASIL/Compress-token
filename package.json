{
  "name": "compress-token",
  "version": "1.4.1",
  "mcpName": "io.github.F7BRASIL/compress-token",
  "description": "Servidor MCP para economia de tokens em agentes de IA — F7 Brasil",
  "type": "module",
  "bin": {
    "compress-token": "./build/index.js",
    "compress-token-hook-filter": "./build/hook-filter.js",
    "compress-token-dashboard": "./build/dashboard.js"
  },
  "main": "./build/index.js",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "postinstall": "node scripts/install-mcp.mjs && node scripts/install-hooks.mjs",
    "uninstall-hooks": "node scripts/uninstall-hooks.mjs",
    "dashboard": "node build/dashboard.js"
  },
  "keywords": [
    "mcp",
    "tokens",
    "compression",
    "claude",
    "cursor",
    "vscode",
    "ai"
  ],
  "author": "F7 Brasil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/f7brasil/Compress-token"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
